"""
Phylogenetic Snakefile for Tahyna virus (TAHV).

One time-resolved build per genome segment (S, M, L): filter the curated ingest
output to the segment + a per-segment length floor, align and QC with nextclade
(treeless, custom reference), apply the approved QC gate (coverage / missing
data / divergence band / frameshifts / stops, with a config exceptions list),
then the standard augur chain: tree (iqtree, augur defaults = fixed GTR) ->
refine (unpinned timetree, root best, coalescent opt, iqd 10, no
stochastic-resolve) -> ancestral (joint) -> translate (GFF3) -> traits ->
export v2 (generous colorings, root sequence inline).

Run (from this directory):
    snakemake -s Snakefile -j4 --dry-run
    snakemake -s Snakefile -j4
"""
import json
import os

workdir: workflow.current_basedir

configfile: "defaults/config.yaml"

SEGMENTS = sorted(config["segments"].keys())  # ['l', 'm', 's']
OUTGROUP_ENABLED = config.get("outgroup", {}).get("enabled", False)
OUTGROUP_TIP = config.get("outgroup", {}).get("tip_name", "OUTGROUP")


def tree_alignment(wc) -> str:
    """Alignment used by tree/refine/ancestral: tangle-named tips (the
    outgroup-inclusive alignment passes through the rename; OUTGROUP keeps its
    name because it is not in the alias/rename map)."""
    return f"results/aligned_tangle_{wc.segment}.fasta"

wildcard_constraints:
    segment = "|".join(SEGMENTS)


def seg_label(wc) -> str:
    """Uppercase genome-segment label for a lowercase build name."""
    return config["segments"][wc.segment]["label"]


rule all:
    input:
        # repo-root auspice/ is the canonical location: nextstrain.org/community
        # serves <repo>/auspice/<name>.json at
        # nextstrain.org/community/<owner>/<repo>/<name>
        expand("../auspice/tahyna_{segment}.json", segment=SEGMENTS),


# --- Inputs from ingest ------------------------------------------------------
rule copy_metadata:
    input:
        os.path.join(config["ingest_results"], "metadata.tsv"),
    output:
        "results/metadata.tsv",
    log:
        "logs/copy_metadata.log",
    shell:
        r"""
        exec &> >(tee {log:q})
        cp {input:q} {output:q}
        """


rule copy_sequences:
    input:
        os.path.join(config["ingest_results"], "sequences.fasta"),
    output:
        "results/sequences.fasta",
    log:
        "logs/copy_sequences.log",
    shell:
        r"""
        exec &> >(tee {log:q})
        cp {input:q} {output:q}
        """


# --- Per-segment builds -------------------------------------------------------
rule filter:
    input:
        metadata="results/metadata.tsv",
        sequences="results/sequences.fasta",
    output:
        metadata="results/filtered_{segment}_metadata.tsv",
        sequences="results/filtered_{segment}.fasta",
    params:
        label=seg_label,
        min_length=lambda wc: config["segments"][wc.segment]["min_length"],
    log:
        "logs/filter_{segment}.log",
    benchmark:
        "benchmarks/filter_{segment}.txt",
    shell:
        r"""
        exec &> >(tee {log:q})
        augur filter \
            --metadata {input.metadata:q} \
            --sequences {input.sequences:q} \
            --query 'segment=="{params.label}"' \
            --query-columns segment:str \
            --min-length {params.min_length} \
            --output-metadata {output.metadata:q} \
            --output-sequences {output.sequences:q}
        """


rule nextclade:
    input:
        sequences="results/filtered_{segment}.fasta",
        reference=lambda wc: os.path.join(config["references"][wc.segment], "reference.fasta"),
        annotation=lambda wc: os.path.join(config["references"][wc.segment], "annotation.gff3"),
        pathogen_json=lambda wc: os.path.join(config["references"][wc.segment], "pathogen.json"),
    output:
        fasta="results/aligned_{segment}.fasta",
        tsv="results/nextclade_{segment}.tsv",
    log:
        "logs/nextclade_{segment}.log",
    benchmark:
        "benchmarks/nextclade_{segment}.txt",
    shell:
        r"""
        exec &> >(tee {log:q})
        nextclade run \
            --input-ref {input.reference:q} \
            --input-annotation {input.annotation:q} \
            --input-pathogen-json {input.pathogen_json:q} \
            --output-fasta {output.fasta:q} \
            --output-tsv {output.tsv:q} \
            {input.sequences:q}
        """


# --- QC gate (approved 2026-10-02, docs/qc-review.md) -------------------------
rule filter_qc:
    input:
        metadata="results/filtered_{segment}_metadata.tsv",
        nextclade="results/nextclade_{segment}.tsv",
        script="bin/apply_qc_gate.py",
    output:
        metadata="results/qc_pass_{segment}_metadata.tsv",
        report="results/dropped_{segment}_qc.tsv",
    params:
        min_coverage=config["qc_gate"]["min_coverage"],
        missing_data_max=lambda wc: config["qc_gate"]["missing_data_max"][wc.segment],
        max_subs=lambda wc: round(
            config["qc_gate"]["max_substitutions_frac"] * config["segments"][wc.segment]["ref_length"]
        ),
        zero_frameshifts=config["qc_gate"]["zero_frameshifts"],
        zero_stop_codons=config["qc_gate"]["zero_stop_codons"],
        zero_flags=" ".join(
            flag
            for flag, enabled in (
                ("--zero-frameshifts", config["qc_gate"]["zero_frameshifts"]),
                ("--zero-stop-codons", config["qc_gate"]["zero_stop_codons"]),
            )
            if enabled
        ),
        exceptions=" ".join(config["qc_gate"].get("exceptions", [])),
    log:
        "logs/filter_qc_{segment}.log",
    shell:
        r"""
        exec &> >(tee {log:q})
        python3 {input.script:q} \
            --metadata {input.metadata:q} \
            --nextclade {input.nextclade:q} \
            --min-coverage {params.min_coverage} \
            --missing-data-max {params.missing_data_max} \
            --max-subs {params.max_subs} \
            {params.zero_flags} \
            --exceptions {params.exceptions} \
            --output {output.metadata:q} \
            --report {output.report:q}
        """


rule subset_alignment:
    input:
        metadata="results/qc_pass_{segment}_metadata.tsv",
        sequences="results/aligned_{segment}.fasta",
    output:
        "results/aligned_qc_{segment}.fasta",
    log:
        "logs/subset_alignment_{segment}.log",
    shell:
        r"""
        exec &> >(tee {log:q})
        augur filter \
            --metadata {input.metadata:q} \
            --sequences {input.sequences:q} \
            --output-sequences {output:q}
        """


# --- Outgroup join (Lumbo; see config.yaml outgroup) ---------------------------
if OUTGROUP_ENABLED:

    rule mafft_add_outgroup:
        input:
            ingroup="results/aligned_qc_{segment}.fasta",
            outgroup=lambda wc: f"../fixture/outgroup/{wc.segment}.fasta",
        output:
            "results/aligned_og_{segment}.fasta",
        params:
            threads=config["tree"]["nthreads"],
        log:
            "logs/mafft_add_outgroup_{segment}.log",
        shell:
            r"""
            exec &> >(tee {log:q})
            mafft \
                --add {input.outgroup:q} \
                --keeplength \
                --thread {params.threads} \
                {input.ingroup:q} \
                > {output:q}
            """

    rule outgroup_hidden:
        # Hide the outgroup tip in auspice instead of pruning the tree:
        # pruning would merge the outgroup's long branch into the ingroup base
        # and distort divergence display; the clock keeps its anchor.
        output:
            "results/outgroup_hidden_{segment}.json",
        params:
            payload=json.dumps({"nodes": {OUTGROUP_TIP: {"hidden": "always"}}}),
        log:
            "logs/outgroup_hidden_{segment}.log",
        shell:
            r"""
            exec &> >(tee {log:q})
            printf {params.payload:q} > {output:q}
            """


# --- Tangle naming -------------------------------------------------------------
# Auspice tangles match tips by byte-exact top-level `name` across segment
# trees, so tips are renamed to segment-independent biological IDs (curated
# aliases + pure isolate names) after the QC gate. Ingest ids stay globally
# unique (one combined FASTA); per-segment uniqueness is enforced here, where
# it is what tangle matching needs.
rule tangle_rename:
    input:
        metadata="results/qc_pass_{segment}_metadata.tsv",
        fasta=lambda wc: (
            f"results/aligned_og_{wc.segment}.fasta"
            if OUTGROUP_ENABLED
            else f"results/aligned_qc_{wc.segment}.fasta"
        ),
        aliases="defaults/tip_name_aliases.tsv",
        script="bin/tangle_names.py",
    output:
        metadata="results/tangle_{segment}_metadata.tsv",
        fasta="results/aligned_tangle_{segment}.fasta",
    log:
        "logs/tangle_rename_{segment}.log",
    shell:
        r"""
        exec &> >(tee {log:q})
        python3 {input.script:q} \
            --metadata {input.metadata:q} \
            --fasta {input.fasta:q} \
            --aliases {input.aliases:q} \
            --output-metadata {output.metadata:q} \
            --output-fasta {output.fasta:q}
        """


# --- Tree chain ----------------------------------------------------------------
rule tree:
    input:
        alignment=tree_alignment,
    output:
        "results/tree_raw_{segment}.nwk",
    params:
        nthreads=config["tree"]["nthreads"],
    log:
        "logs/tree_{segment}.log",
    benchmark:
        "benchmarks/tree_{segment}.txt",
    shell:
        r"""
        exec &> >(tee {log:q})
        augur tree \
            --method iqtree \
            --alignment {input:q} \
            --output {output:q} \
            --nthreads {params.nthreads}
        """


def refine_flags(wc) -> str:
    """refine flag string for one build: outgroup rooting when enabled, with
    per-segment overrides still able to retire the timetree (S: negative rate
    estimate even outgroup-rooted - the tree ships divergence-only, rooted on
    the outgroup; treetime also auto-prunes the undated outgroup tip from
    timetrees, while for S the outgroup_hidden node-data hides it in auspice).
    """
    override = config["refine"].get("overrides", {}).get(wc.segment, {})
    timetree = override.get("timetree", True)

    if OUTGROUP_ENABLED:
        root = OUTGROUP_TIP
        if not timetree:
            return f"--root {root} "
        return (
            "--timetree --date-confidence "
            f"--coalescent {config['refine']['coalescent']} "
            f"--date-inference {config['refine']['date_inference']} "
            f"--root {root} "
        )

    if not timetree:
        return ""
    root = override.get("root", config["refine"]["root"]) or config["refine"]["root"]
    return (
        "--timetree --date-confidence "
        f"--coalescent {config['refine']['coalescent']} "
        f"--date-inference {config['refine']['date_inference']} "
        f"--root {root} "
    )


rule refine:
    input:
        tree="results/tree_raw_{segment}.nwk",
        alignment=tree_alignment,
        metadata="results/tangle_{segment}_metadata.tsv",
    output:
        tree="results/tree_{segment}.nwk",
        node_data="results/refine_{segment}.json",
    params:
        flags=refine_flags,
        clock_filter_iqd=config["refine"]["clock_filter_iqd"],
    log:
        "logs/refine_{segment}.log",
    benchmark:
        "benchmarks/refine_{segment}.txt",
    shell:
        r"""
        exec &> >(tee {log:q})
        augur refine \
            --tree {input.tree:q} \
            --alignment {input.alignment:q} \
            --metadata {input.metadata:q} \
            --output-tree {output.tree:q} \
            --output-node-data {output.node_data:q} \
            {params.flags} \
            --clock-filter-iqd {params.clock_filter_iqd}
        """


rule ancestral:
    input:
        tree="results/tree_{segment}.nwk",
        alignment=tree_alignment,
    output:
        "results/nt_muts_{segment}.json",
    params:
        inference=config["ancestral"]["inference"],
    log:
        "logs/ancestral_{segment}.log",
    benchmark:
        "benchmarks/ancestral_{segment}.txt",
    shell:
        r"""
        exec &> >(tee {log:q})
        augur ancestral \
            --tree {input.tree:q} \
            --alignment {input.alignment:q} \
            --inference {params.inference} \
            --output-node-data {output:q}
        """


# aa annotation, isolated behind this one rule: swapping to a nextclade-based
# translation later means changing only here.
rule translate:
    input:
        tree="results/tree_{segment}.nwk",
        ancestral="results/nt_muts_{segment}.json",
        reference=lambda wc: os.path.join(config["references"][wc.segment], "annotation.gff3"),
    output:
        "results/aa_muts_{segment}.json",
    log:
        "logs/translate_{segment}.log",
    benchmark:
        "benchmarks/translate_{segment}.txt",
    shell:
        r"""
        exec &> >(tee {log:q})
        augur translate \
            --tree {input.tree:q} \
            --ancestral-sequences {input.ancestral:q} \
            --reference-sequence {input.reference:q} \
            --output-node-data {output:q}
        """


rule traits:
    input:
        tree="results/tree_{segment}.nwk",
        metadata="results/tangle_{segment}_metadata.tsv",
    output:
        "results/traits_{segment}.json",
    params:
        columns=" ".join(config["traits"]["columns"]),
    log:
        "logs/traits_{segment}.log",
    shell:
        r"""
        exec &> >(tee {log:q})
        augur traits \
            --tree {input.tree:q} \
            --metadata {input.metadata:q} \
            --columns {params.columns} \
            --confidence \
            --output-node-data {output:q}
        """


rule export:
    input:
        tree="results/tree_{segment}.nwk",
        node_data=lambda wc: [
            f"results/refine_{wc.segment}.json",
            f"results/nt_muts_{wc.segment}.json",
            f"results/aa_muts_{wc.segment}.json",
            f"results/traits_{wc.segment}.json",
        ]
        + ([f"results/outgroup_hidden_{wc.segment}.json"] if OUTGROUP_ENABLED else []),
        metadata="results/tangle_{segment}_metadata.tsv",
        auspice_config="defaults/auspice_config.json",
    output:
        "../auspice/tahyna_{segment}.json",
    log:
        "logs/export_{segment}.log",
    shell:
        r"""
        exec &> >(tee {log:q})
        augur export v2 \
            --tree {input.tree:q} \
            --node-data {input.node_data} \
            --metadata {input.metadata:q} \
            --auspice-config {input.auspice_config:q} \
            --include-root-sequence-inline \
            --output {output:q}
        """
